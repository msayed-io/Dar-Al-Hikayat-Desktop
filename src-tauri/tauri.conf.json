{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dar Al-Hikayat",
  "version": "3.0.0",
  "identifier": "com.daralhikayat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": { "capabilities": ["default"] },
    "windows": [{
      "label": "main",
      "title": "دَارُ الحِكَايَاتِ",
      "width": 1440,
      "height": 900,
      "minWidth": 1024,
      "minHeight": 680,
      "resizable": true,
      "center": true,
      "fullscreen": false,
      "decorations": true,
      "devtools": false
    }]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": ["nsis", "msi"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
